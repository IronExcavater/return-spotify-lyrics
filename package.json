{
    "name": "return-spotify-lyrics",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "format": "prettier . --check",
        "format:fix": "prettier . --write",
        "knip": "knip",
        "check": "pnpm typecheck && pnpm lint && pnpm format && pnpm knip",
        "clean": "node --disable-warning=ExperimentalWarning scripts/clean.mjs && pnpm --filter @return-spotify-lyrics/extension exec wxt prepare",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "knip": "^6.45.1",
        "lint-staged": "^17.6.1",
        "oxlint": "^1.78.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "turbo": "^2.10.10"
    }
}
