{
    "name": "return-spotify-lyrics",
    "version": "0.5.0",
    "description": "A Spotify companion extension for playback and synchronized lyrics.",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "scripts": {
        "dev": "turbo run dev",
        "dev:extension": "turbo run dev --filter=@return-spotify-lyrics/extension",
        "storybook": "turbo run dev --filter=@return-spotify-lyrics/storybook",
        "site": "turbo run dev --filter=@return-spotify-lyrics/site",
        "build": "turbo run build",
        "build:extension": "turbo run build --filter=@return-spotify-lyrics/extension",
        "build:storybook": "turbo run build --filter=@return-spotify-lyrics/storybook",
        "build:site": "turbo run build --filter=@return-spotify-lyrics/site",
        "typecheck": "turbo run typecheck",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "format": "prettier . --check",
        "format:fix": "prettier . --write",
        "check": "pnpm typecheck && pnpm lint && pnpm format"
    },
    "devDependencies": {
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "turbo": "^2.10.7"
    }
}
