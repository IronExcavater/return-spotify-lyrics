---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entries = (await getCollection('changelog')).sort(
    (left, right) => right.data.date.getTime() - left.data.date.getTime()
);
---

<SiteLayout title="Changelog · Return Spotify Lyrics">
    <section class="prose-page">
        <h1>Changelog</h1>
        <p>
            Product-facing release notes will live here as the extension moves
            toward public releases.
        </p>

        <div class="mt-10 grid gap-3">
            {
                entries.map((entry) => (
                    <a
                        class="block rounded-panel border border-border bg-surface p-5 transition hover:bg-surface-hover hover:text-text"
                        href={`/changelog/${entry.id}/`}
                    >
                        <div class="flex flex-wrap items-baseline justify-between gap-2">
                            <strong>
                                {entry.data.version} · {entry.data.title}
                            </strong>
                            <time
                                class="text-xs text-text-muted"
                                datetime={entry.data.date.toISOString()}
                            >
                                {entry.data.date.toLocaleDateString('en-AU')}
                            </time>
                        </div>
                        <p class="mt-2 mb-0 text-sm text-text-muted">
                            {entry.data.summary}
                        </p>
                    </a>
                ))
            }
        </div>
    </section>
</SiteLayout>
