---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout title="Privacy · Return Spotify Lyrics">
    <section class="prose-page">
        <h1>Privacy</h1>
        <div class="notice">
            <strong>Draft placeholder</strong>
            <p>
                This page is structural only and is not the final privacy
                policy. Final wording must be reviewed against the production
                extension, backend, analytics, authentication, and
                data-retention behaviour before publication.
            </p>
        </div>
        <h2>Planned coverage</h2>
        <ul>
            <li>Spotify and account data accessed by the extension.</li>
            <li>Authentication and backend data handling.</li>
            <li>Local browser storage and cached lyrics.</li>
            <li>Retention, deletion, support, and contact information.</li>
        </ul>
    </section>
</SiteLayout>
