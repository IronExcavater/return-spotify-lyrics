{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".output/**", "storybook-static/**"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "lint": {},
        "test": {},
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
