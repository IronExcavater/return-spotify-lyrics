{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".output/**", "dist/**", "storybook-static/**"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"],
            "outputs": []
        },
        "lint": {
            "outputs": []
        },
        "test": {
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
